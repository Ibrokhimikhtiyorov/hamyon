# BotFather'dan olingan token (bu yerga haqiqiy token yozmang!)
# Haqiqiy token Render Environment yoki .env faylida bo'lishi kerak.
BOT_TOKEN=1234567890:AAYOUR_BOT_TOKEN_HERE

# HamyonAPI (Render Environment yoki .env)
HAMYON_SHOP_ID=YOUR_HAMYON_SHOP_ID
HAMYON_SHOP_KEY=YOUR_HAMYON_SHOP_KEY
HAMYON_API_BASE=https://hamyon-api.uz
HAMYON_TIMEOUT=15

# Adminlarning Telegram ID lari (vergul bilan)
ADMIN_IDS=YOUR_TELEGRAM_USER_ID

# Ixtiyoriy: login-parollarni shifrlash kaliti.
# Bo'sh qoldirilsa, data/fernet.key avtomatik yaratiladi.
# Yangi kalit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# To'lov kartasi (balans to'ldirish uchun)
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_HOLDER=Marketplace Admin

# Yordam uchun Telegram username (bo'sh bo'lsa yordam tugmasi chiqmaydi)
SUPPORT_USERNAME=

# Ixtiyoriy sozlamalar
COMMISSION_PERCENT=15
PAYMENT_MINUTES=5
CHECK_MINUTES=10
PENALTY_PERCENT=10
PENALTY_INTERVAL_MINUTES=10
AUTO_COMPLETE_MINUTES=60
MIN_PRICE=1000
MIN_TOPUP=1000
MIN_WITHDRAW=5000
